<mxfile host="Electron" type="device"><diagram id="l1" name="L1 · System context"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l1-title" value="Mentorly — System Context (C4 level 1)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="l1-sub" value="Who uses Mentorly and which outside systems it depends on. Admins have no UI in the MVP – they work through internal scripts." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1100" height="30" as="geometry"/></mxCell><mxCell id="l1-guest" value="&lt;b style=&quot;font-size:14px&quot;&gt;Guest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Unauthenticated visitor: discovers the platform, searches mentors, signs up.&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="220" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l1-mentee" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mentee (cursant)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;16+. Applies, pays, books sessions, tracks progress, reviews mentors.&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="520" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l1-mentor" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mentor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Manually approved professional (or sponsored employee). Selects mentees, holds sessions, evaluates, gets paid.&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="820" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l1-admin" value="&lt;b style=&quot;font-size:14px&quot;&gt;Admin (Mentorly team)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Verifies mentors, selects sponsored beneficiaries, manages sponsors, FAQ, exceptions.&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l1-sys" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mentorly&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Responsive web platform (Romanian UI, RON): mentor search &amp;amp; top-3 matching, applications with optional tests, one free intro call per account, scheduling on Google Meet (reschedule, never cancel), payments with escrow &amp;amp; twice-a-month payouts, progress tracking, ratings &amp;amp; reviews, sponsored program.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#1061B0;fontColor=#ffffff;strokeColor=#0D5091;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="430" width="1140" height="150" as="geometry"/></mxCell><mxCell id="l1-google" value="&lt;b style=&quot;font-size:14px&quot;&gt;Google&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Google Identity (OAuth login) + Calendar / Meet API. Mentees and mentors join the generated Meet links directly.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="730" width="260" height="150" as="geometry"/></mxCell><mxCell id="l1-stripe" value="&lt;b style=&quot;font-size:14px&quot;&gt;Stripe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Stripe Connect marketplace: card payments, monthly subscriptions, transfers to mentors.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="493" y="730" width="260" height="150" as="geometry"/></mxCell><mxCell id="l1-email" value="&lt;b style=&quot;font-size:14px&quot;&gt;Email provider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External System – TBD]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Delivers transactional emails (Romanian templates).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="786" y="730" width="260" height="150" as="geometry"/></mxCell><mxCell id="l1-msg" value="&lt;b style=&quot;font-size:14px&quot;&gt;Messaging provider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External System – TBD]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Telegram / Discord / Slack… Private and cohort groups created via API; mentors and mentees chat there directly (no in-app chat).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="730" width="260" height="150" as="geometry"/></mxCell><mxCell id="l1-1" value="&lt;b&gt;Browses, searches mentors, signs up&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.105;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-guest" target="l1-sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-2" value="&lt;b&gt;Applies, pays, books, rates&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.368;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-mentee" target="l1-sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-3" value="&lt;b&gt;Publishes offer, decides, evaluates&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.632;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-mentor" target="l1-sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-4" value="&lt;b&gt;Approves mentors, selects beneficiaries&lt;/b&gt;&lt;br&gt;[internal scripts]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.895;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-admin" target="l1-sys"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-5" value="&lt;b&gt;Logs users in; creates Meet events&lt;/b&gt;&lt;br&gt;[OAuth / REST]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.114;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-sys" target="l1-google"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-6" value="&lt;b&gt;Charges, subscriptions, payouts&lt;/b&gt;&lt;br&gt;[REST + webhooks]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.371;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-sys" target="l1-stripe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-7" value="&lt;b&gt;Sends notifications&lt;/b&gt;&lt;br&gt;[SMTP / API]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.628;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-sys" target="l1-email"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-8" value="&lt;b&gt;Creates groups, adds / removes members&lt;/b&gt;&lt;br&gt;[REST]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.886;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l1-sys" target="l1-msg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l1-legend" value="&lt;b&gt;Legend&lt;/b&gt; — dark blue: person · blue: Mentorly · grey: external system · arrows: “uses” with protocol" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#333333;spacing=6;strokeColor=#BBBBBB;fillColor=#FAFAFA;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="200" y="930" width="1140" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="l2" name="L2 · Containers"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l2-title" value="Mentorly — Containers (C4 level 2)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="l2-sub" value="Deployable pieces inside Mentorly. API and workers share one NestJS codebase and one PostgreSQL database; workers pick up work the API writes to the DB (session_reminders, email_outbox, held sessions, payouts)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1400" height="40" as="geometry"/></mxCell><mxCell id="l2-admin" value="&lt;b style=&quot;font-size:14px&quot;&gt;Admin&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l2-guest" value="&lt;b style=&quot;font-size:14px&quot;&gt;Guest&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="300" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l2-mentee" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mentee&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="540" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l2-mentor" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mentor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Person]&lt;/span&gt;" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];" vertex="1" parent="1"><mxGeometry x="780" y="110" width="200" height="180" as="geometry"/></mxCell><mxCell id="l2-bnd" value="&lt;b&gt;Mentorly&lt;/b&gt;&lt;br&gt;[Software System]" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="30" y="330" width="1450" height="830" as="geometry"/></mxCell><mxCell id="l2-web" value="&lt;b style=&quot;font-size:14px&quot;&gt;Web App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Container: React + Vite SPA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Public site (landing, FAQ, search, mentor profiles) + mentee and mentor dashboards. Responsive, Romanian only.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="380" width="620" height="140" as="geometry"/></mxCell><mxCell id="l2-files" value="&lt;b style=&quot;font-size:14px&quot;&gt;Object storage&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Container: S3-compatible bucket]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;CVs, certificates, study materials, deliverables, avatars, logos (metadata in files).&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1100" y="380" width="300" height="140" as="geometry"/></mxCell><mxCell id="l2-api" value="&lt;b style=&quot;font-size:14px&quot;&gt;API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Container: NestJS (Node.js)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;REST/JSON. Auth (JWT + users.token_version), search &amp;amp; matching, applications, scheduling (creates Meet events), payments, progress, reviews. Receives Stripe webhooks.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="320" y="640" width="320" height="170" as="geometry"/></mxCell><mxCell id="l2-workers" value="&lt;b style=&quot;font-size:14px&quot;&gt;Background workers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Container: NestJS scheduler (same codebase)]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Marks past sessions HELD, sends reminders, drains email_outbox, runs biweekly payouts, creates messaging groups, retries failed Meet / group calls.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="640" width="340" height="170" as="geometry"/></mxCell><mxCell id="l2-cli" value="&lt;b style=&quot;font-size:14px&quot;&gt;Admin scripts&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Container: NestJS CLI commands]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Verify mentors, select beneficiaries, sponsors, refunds, free-call reset. Writes admin_audit_log.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="240" height="160" as="geometry"/></mxCell><mxCell id="l2-db" value="&lt;b style=&quot;font-size:14px&quot;&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[Container: PostgreSQL 16]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;41 tables, schema owned by TypeORM migrations. EXCLUDE constraints block double-booking.&lt;/span&gt;" style="shape=cylinder3;size=14;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;metaEdit=1;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="920" width="380" height="170" as="geometry"/></mxCell><mxCell id="l2-google" value="&lt;b style=&quot;font-size:14px&quot;&gt;Google&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;OAuth + Calendar / Meet API&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="360" width="240" height="110" as="geometry"/></mxCell><mxCell id="l2-stripe" value="&lt;b style=&quot;font-size:14px&quot;&gt;Stripe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Connect + Billing&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="560" width="240" height="120" as="geometry"/></mxCell><mxCell id="l2-msg" value="&lt;b style=&quot;font-size:14px&quot;&gt;Messaging provider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External – TBD]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="740" width="240" height="100" as="geometry"/></mxCell><mxCell id="l2-email" value="&lt;b style=&quot;font-size:14px&quot;&gt;Email provider&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#E6F2FA&quot;&gt;[External – TBD]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#8C8496;fontColor=#ffffff;strokeColor=#736782;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="920" width="240" height="100" as="geometry"/></mxCell><mxCell id="l2-1" value="&lt;b&gt;Visits&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.129;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-guest" target="l2-web"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-2" value="&lt;b&gt;Uses&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#82