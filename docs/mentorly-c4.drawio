1" parent="1" source="l2-web" target="l2-files"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-7" value="&lt;b&gt;Issues signed URLs&lt;/b&gt; [S3 API]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.69;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-api" target="l2-files"><mxGeometry x="0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="541" y="560"/><mxPoint x="1250" y="560"/></Array></mxGeometry></mxCell><mxCell id="l2-8" value="&lt;b&gt;OAuth login; creates / updates Meet events&lt;/b&gt; [HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.875;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-api" target="l2-google"><mxGeometry x="-0.15" relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="590"/><mxPoint x="1520" y="590"/><mxPoint x="1520" y="415"/></Array></mxGeometry></mxCell><mxCell id="l2-9" value="&lt;b&gt;Payments, subscriptions, Connect onboarding; receives webhooks&lt;/b&gt; [HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-api" target="l2-stripe"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="624" y="620"/><mxPoint x="1540" y="620"/><mxPoint x="1540" y="596"/></Array></mxGeometry></mxCell><mxCell id="l2-10" value="&lt;b&gt;Reads / writes&lt;/b&gt;&lt;br&gt;[SQL (TypeORM)]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.85;exitY=1;exitDx=0;exitDy=0;entryX=0.37;entryY=0.03;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-api" target="l2-db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="592" y="870"/><mxPoint x="560" y="870"/></Array></mxGeometry></mxCell><mxCell id="l2-11" value="&lt;b&gt;Polls due work, updates state&lt;/b&gt;&lt;br&gt;[SQL]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.79;entryY=0.03;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-workers" target="l2-db"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="870"/><mxPoint x="720" y="870"/></Array></mxGeometry></mxCell><mxCell id="l2-12" value="&lt;b&gt;Admin operations + audit log&lt;/b&gt;&lt;br&gt;[SQL]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-cli" target="l2-db"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-13" value="&lt;b&gt;Biweekly payouts (transfers)&lt;/b&gt;&lt;br&gt;[HTTPS]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.15;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-workers" target="l2-stripe"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-14" value="&lt;b&gt;Creates groups, adds / removes members&lt;/b&gt;&lt;br&gt;[REST]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.55;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-workers" target="l2-msg"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l2-15" value="&lt;b&gt;Sends queued emails&lt;/b&gt;&lt;br&gt;[SMTP / API]" style="endArrow=blockThin;endFill=1;endSize=12;html=1;fontSize=10;fontColor=#404040;strokeColor=#828282;strokeWidth=1.2;labelBackgroundColor=#ffffff;rounded=1;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l2-workers" target="l2-email"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="l3" name="L3 · API components &amp; tables"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="l3-title" value="Mentorly API — Components and the tables they own (C4 level 3)" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1400" height="30" as="geometry"/></mxCell><mxCell id="l3-sub" value="One NestJS module per box. A module writes only its own tables (listed in the box); other modules go through its service. Background jobs in the workers container reuse these modules." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1500" height="40" as="geometry"/></mxCell><mxCell id="l3-bnd" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;[Container: NestJS]" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;metaEdit=1;absoluteArcSize=1;container=0;" vertex="1" parent="1"><mxGeometry x="340" y="230" width="1830" height="1110" as="geometry"/></mxCell><mxCell id="l3-auth" value="&lt;b style=&quot;font-size:14px&quot;&gt;Auth &amp;amp; Users&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Sign-up (email or Google), 16+ age check, login / logout via token_version, GDPR delete.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;users, user_auth_providers&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="270" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-profiles" value="&lt;b style=&quot;font-size:14px&quot;&gt;Profiles&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Mentor profile &amp;amp; verification status, mentee matching form, credentials, social links, favourites, domains.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;mentor_profiles, mentee_profiles, mentor_credentials, mentor_social_links, favourites, domains&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="270" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-search" value="&lt;b style=&quot;font-size:14px&quot;&gt;Search &amp;amp; Matching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Public search with filters; top-3 = same domain sorted by rating. Read-only.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; none – reads profiles, mentorships, availability_slots, mentor_rating_stats&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="270" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-payments" value="&lt;b style=&quot;font-size:14px&quot;&gt;Payments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Per-session charges, subscription invoices, escrow, commission snapshot, biweekly payouts, Stripe webhooks (idempotent).&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;payments, payouts, payout_items, stripe_webhook_events&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1760" y="270" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-files" value="&lt;b style=&quot;font-size:14px&quot;&gt;Files&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Upload metadata + signed URLs; PUBLIC / PRIVATE visibility.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;files&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-mentorships" value="&lt;b style=&quot;font-size:14px&quot;&gt;Mentorships&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;The offer: prices, N sessions, duration, publish rules, weekly availability, ≤3 application questions, test &amp;amp; materials.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;mentorships, availability_slots, mentorship_questions, study_materials&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="540" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-applications" value="&lt;b style=&quot;font-size:14px&quot;&gt;Applications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Apply (answers + test + own questions), mentor answers &amp;amp; decides, mandatory rejection reason, re-apply.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;applications, application_answers, application_mentee_questions&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="540" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-scheduling" value="&lt;b style=&quot;font-size:14px&quot;&gt;Scheduling&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Free intro call (1 per account), slot booking, Meet links, reschedule (never cancel), held job, reminders, .ics.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;sessions, session_reschedules, session_reminders&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1760" y="540" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-content" value="&lt;b style=&quot;font-size:14px&quot;&gt;Content&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;FAQ and landing-page testimonials, editable without deploy.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;faq_items, platform_testimonials&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="380" y="810" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-sponsors" value="&lt;b style=&quot;font-size:14px&quot;&gt;Sponsors &amp;amp; Program&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Sponsor pages + badges, applications to the free program, beneficiary selection.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;sponsors, sponsored_program_applications&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="840" y="810" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-enrolments" value="&lt;b style=&quot;font-size:14px&quot;&gt;Enrolments&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Start (per session / monthly / sponsored), subscription mirror, sessions left in cycle, end mentorship.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;enrolments, subscriptions&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="810" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-messaging" value="&lt;b style=&quot;font-size:14px&quot;&gt;Messaging Groups&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Provider-agnostic adapter: private group per enrolment, cohort group per mentor, membership history.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;messaging_groups, messaging_group_members&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];fillColor=#63BEF2;fontColor=#000000;strokeColor=#2086C9;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1760" y="810" width="370" height="220" as="geometry"/></mxCell><mxCell id="l3-adminops" value="&lt;b style=&quot;font-size:14px&quot;&gt;Admin Ops&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#1B3A57&quot;&gt;[Component: NestJS module]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Commands used by admin scripts: verify mentors, select beneficiaries, refunds, free-call reset, payout exclusions.&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;&lt;i&gt;Tables:&lt;/i&gt; &lt;font face=&quot;Courier New&quot;&gt;admin_audit_log&lt;/font&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;align=center;arcSize=6;metaEdit=1;verticalAlign=middle;spacing=8;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,